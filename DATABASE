CREATE DATABASE SAUDECONECTA;


USE SAUDECONECTA;

CREATE TABLE  Patient (
PatientID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
Patientname VARCHAR (120),
CPF VARCHAR (14),
birthdate DATE,
phone VARCHAR (20),
email VARCHAR (120)
);

CREATE TABLE DOCTOR (
DoctorID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
Doctorname VARCHAR (120),
crm VARCHAR (20),
specialty VARCHAR (100),
PHONE VARCHAR (20)
);

CREATE TABLE medication (
medicationID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
MedicationName VARCHAR (120),
activeIngredient VARCHAR (120),
Strenght VARCHAR (20)
);

CREATE TABLE avaibleslots (
slotid INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
doctorid INT UNSIGNED,
dayofweek VARCHAR (15),
starttime TIME,
endtime TIME,
FOREIGN KEY (doctorID) REFERENCES doctor (DoctorID)
);

CREATE TABLE ADDRESS (
AddressID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
ZipCode VARCHAR (10),
Street VARCHAR (150),
Number VARCHAR (20),
complement  VARCHAR (100)
);


CREATE TABLE APPOINTMENT (
appointmentID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
patientID INT UNSIGNED,
DoctorID INT UNSIGNED,
appoitmentdate DATETIME,
status VARCHAR (20),
notes TEXT,
FOREIGN KEY (patientID) REFERENCES patient (patientid),
FOREIGN KEY (doctorID) REFERENCES doctor (doctorid)
);

CREATE TABLE EXAM (
examID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
appointmentID INT UNSIGNED,
examname VARCHAR (120),
RequestDate DATETIME,
FOREIGN KEY (appointmentID) REFERENCES appointment (appointmentID)
);

CREATE TABLE ExamResult (
ExamResultID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
EXAMID INT UNSIGNED,
value VARCHAR (100),
RESULT TEXT,
resultDATE DATETIME,
FOREIGN KEY (EXAMID) REFERENCES EXAM (EXAMID)
);

CREATE TABLE SCHEDULE (
scheduleID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
doctorID INT UNSIGNED,
PATIENTID INT UNSIGNED,
scheduledate DATETIME ,
FOREIGN KEY (doctorid) REFERENCES doctor (doctorid),
FOREIGN KEY (patientid) REFERENCES patient (patientid)
);

CREATE TABLE INVOICE (
InvoiceID INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
appointmentid INT UNSIGNED, 
totalamount DECIMAL (10,2),
issueTIME DATETIME,
status VARCHAR (20),
FOREIGN KEY (appointmentID) REFERENCES appointment (appointmentid)
);

CREATE TABLE Paymentid (
paymentid INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
invoiceID INT UNSIGNED,
paidamount DECIMAL (10,2),
paymentmethod VARCHAR (30),
paymentdate DATETIME,
paymentstatus ENUM('Aprovado','Recusado','Em analise','Cancelado'),
FOREIGN KEY (invoiceid) REFERENCES INVOICE (INVOICEID)
);

CREATE TABLE Prescription (
    prescriptionid INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
    appointmentid INT UNSIGNED,
    doctorid INT UNSIGNED,
    issuedate DATETIME,
    notes TEXT,
    validuntil DATE,
    status VARCHAR(20),
    FOREIGN KEY (appointmentid)
        REFERENCES appointment (appointmentid),
    FOREIGN KEY (doctorid)
        REFERENCES doctor (doctorid)
);
CREATE TABLE Prescription_item ( 
prescriptionitemid INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
medicationid INT UNSIGNED,
prescriptionid INT UNSIGNED, 
appointmentid INT UNSIGNED,
doctorid INT UNSIGNED, 
issuedate DATETIME,
notes TEXT,
valid_until DATE,
status VARCHAR(20),
FOREIGN KEY (medicationid) REFERENCES medication(medicationid),
FOREIGN KEY (prescriptionid) REFERENCES prescription(prescriptionid)
);
CREATE TABLE contact (
contactid INT UNSIGNED NOT NULL PRIMARY KEY AUTO_INCREMENT,
patientid INT UNSIGNED,
doctorid INT UNSIGNED,
FOREIGN KEY (patientid) REFERENCES patient(patientid),
FOREIGN KEY (doctorid) REFERENCES doctor(doctorid)
); 

ALTER TABLE DOCTOR ADD CONSTRAINT UNQD UNIQUE (CRM);
ALTER TABLE PATIENT ADD CONSTRAINT UNQP UNIQUE (CPF,EMAIL);




