CREATE DATABASE SAUDECONECTA;

USE SAUDECONECTA;

CREATE TABLE  Patient (
PatientID INT PRIMARY KEY AUTO_INCREMENT,
Patientname VARCHAR (120),
CPF VARCHAR (14),
birthdate DATE,
phone VARCHAR (20),
email VARCHAR (120)
);

CREATE TABLE DOCTOR (
DoctorID INT PRIMARY KEY AUTO_INCREMENT,
Doctorname VARCHAR (120),
crm VARCHAR (20),
specialty VARCHAR (100),
PHONE VARCHAR (20)
);

CREATE TABLE medication (
medicationID INT PRIMARY KEY AUTO_INCREMENT,
MedicationName VARCHAR (120),
activeIngredient VARCHAR (120),
Strenght VARCHAR (20)
);

CREATE TABLE ADDRESS (
AddressID INT PRIMARY KEY AUTO_INCREMENT,
ZipCode VARCHAR (10),
Street VARCHAR (150),
Number VARCHAR (20),
complement  VARCHAR (100)
);

CREATE TABLE APPOINTMENT (
appointmentID INT PRIMARY KEY AUTO_INCREMENT,
patientID INT,
DoctorID INT,
appoitmentdate DATETIME,
status VARCHAR (20),
notes TEXT,
FOREIGN KEY (patientID) REFERENCES patient (patientid),
FOREIGN KEY (doctorID) REFERENCES doctor (doctorid)
);

CREATE TABLE EXAM (
examID INT PRIMARY KEY AUTO_INCREMENT,
appointmentID INT,
examname VARCHAR (120),
RequestDate DATETIME,
FOREIGN KEY (appointmentID) REFERENCES appointment (appointmentID)
);

CREATE TABLE ExamResult (
ExamResultID INT PRIMARY KEY AUTO_INCREMENT,
EXAMID INT,
value VARCHAR (100),
RESULT TEXT,
resultDATE DATETIME,
FOREIGN KEY (EXAMID) REFERENCES EXAM (EXAMID)
);

CREATE TABLE SCHEDULE (
scheduleID INT PRIMARY KEY AUTO_INCREMENT,
doctorID INT,
PATIENTID INT,
scheduledate DATETIME ,
FOREIGN KEY (doctorid) REFERENCES doctor (doctorid),
FOREIGN KEY (patientid) REFERENCES patient (patientid)
);

CREATE TABLE INVOICE (
InvoiceID INT PRIMARY KEY AUTO_INCREMENT,
appointmentid INT, 
totalamount DECIMAL (10,2),
issueTIME DATETIME,
status VARCHAR (20),
FOREIGN KEY (appointmentID) REFERENCES appointment (appointmentid)
);

CREATE TABLE PaymentID (
paymentid INT PRIMARY KEY AUTO_INCREMENT,
invoiceID INT,
paidamount DECIMAL (10,2),
paymentmethod VARCHAR (30),
paymentdate DATETIME,
paymentstatus ENUM('Aprovado','Recusado','Em analise','Cancelado'),
FOREIGN KEY (invoiceid) REFERENCES INVOICE (INVOICEID)
);

CREATE TABLE Prescription (
prescriptionid INT PRIMARY KEY AUTO_INCREMENT,
appointmentid INT,
doctorid INT,
issuedate DATETIME,
notes TEXT,
validuntil DATE,
status VARCHAR(20),
FOREIGN KEY (appointmentid) REFERENCES appointment(appointmentid),
FOREIGN KEY (doctorid) REFERENCES doctor(doctorid)
);
CREATE TABLE Prescription_item ( 
prescriptionitemid INT PRIMARY KEY AUTO_INCREMENT,
medicationid INT,
prescriptionid INT, 
appointmentid INT,
doctorid INT, 
issuedate DATETIME,
notes TEXT,
valid_until DATE,
status VARCHAR(20),
FOREIGN KEY (medicationid) REFERENCES medication(medicationid),
FOREIGN KEY (prescriptionid) REFERENCES prescription(prescriptionid)
);
CREATE TABLE contact (
contactid INT PRIMARY KEY AUTO_INCREMENT,
patientid INT,
doctorid INT,
FOREIGN KEY (patientid) REFERENCES patient(patientid),
FOREIGN KEY (doctorid) REFERENCES doctor(doctorid)
); 

RENAME TABLE paymentid to payment
